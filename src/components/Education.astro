---
import { config } from '../config';
import SectionHeading from './SectionHeading.astro';
---

{
  config.education.length > 0 && (
    <section id="education" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <div class="lg:col-span-4">
          <SectionHeading title="Education" />
        </div>
        <div class="lg:col-span-8 space-y-6">
          {config.education.map((e) => (
            <article class="bg-gray-50 border border-gray-200 rounded-xl sm:rounded-2xl p-5 sm:p-8">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="text-xl sm:text-2xl font-bold text-gray-900">{e.school}</h3>
                <span class="text-sm" style="color: var(--accent)">{e.dateRange}</span>
              </div>
              <p class="mt-1 text-gray-700 font-medium">{e.degree}</p>
              {e.details && <p class="mt-3 text-sm sm:text-base text-gray-600">{e.details}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
