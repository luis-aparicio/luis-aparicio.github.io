---
import { config } from '../config';
import SectionHeading from './SectionHeading.astro';
---

{
  config.experience.length > 0 && (
    <section id="experience" class="p-8 sm:p-12 md:p-16 lg:p-24 bg-gray-50">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <div class="lg:col-span-4">
          <SectionHeading title="Experience" />
        </div>
        <div class="lg:col-span-8 space-y-6">
          {config.experience.map((job) => (
            <article class="bg-white border border-gray-200 rounded-xl sm:rounded-2xl p-5 sm:p-8">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="text-xl sm:text-2xl font-bold text-gray-900">{job.company}</h3>
                <span class="text-sm" style="color: var(--accent)">{job.dateRange}</span>
              </div>
              <p class="mt-1 text-gray-700 font-medium">{job.title}</p>
              {job.location && <p class="text-sm text-gray-500">{job.location}</p>}
              {job.summary && <p class="mt-4 text-gray-600">{job.summary}</p>}
              <ul class="mt-4 space-y-3 text-sm sm:text-base text-gray-600 leading-relaxed list-disc pl-5 marker:text-gray-400">
                {job.bullets.map((b) => (
                  <li>
                    {b.label && <strong class="text-gray-900">{b.label}: </strong>}
                    {b.text}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
