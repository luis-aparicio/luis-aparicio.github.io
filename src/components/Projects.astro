---
import { config, type Project } from '../config';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const projects: Project[] = config.projects;

// Offer filters only for skills shared by 2+ projects; a filter matching one card is noise.
const counts = new Map<string, number>();
projects.forEach((p) => p.skills.forEach((s) => counts.set(s, (counts.get(s) ?? 0) + 1)));
const filters = [...counts].filter(([, n]) => n > 1).map(([s]) => s).sort();

const pad = (n: number) => String(n + 1).padStart(2, '0');
const coverOf = (p: Project) => {
  const m = p.media?.[0];
  return m ? (m.type === 'video' ? m.poster : m.src) : undefined;
};
const hasVideo = (p: Project) => p.media?.some((m) => m.type === 'video') ?? false;
---

{
  projects.length > 0 && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24 bg-gray-50">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <div class="lg:col-span-4 lg:sticky lg:top-24">
          <SectionHeading title="Projects" />
          {filters.length > 0 && (
            <div id="project-filters" class="mt-8 flex flex-wrap gap-2" aria-label="Filter projects by skill">
              <button type="button" data-filter="" class="filter-btn active">All</button>
              {filters.map((f) => (
                <button type="button" data-filter={f} class="filter-btn">{f}</button>
              ))}
            </div>
          )}
        </div>

        <div class="lg:col-span-8 space-y-8">
          {projects.map((p, i) => {
            const cover = coverOf(p);
            return (
              <article
                class="project-card group bg-white rounded-xl sm:rounded-2xl border border-gray-200 overflow-hidden transition-all duration-300 hover:shadow-xl hover:border-gray-300 hover:-translate-y-1"
                data-skills={JSON.stringify(p.skills)}
                data-media={JSON.stringify(p.media ?? [])}
              >
                {cover && (
                  <button
                    type="button"
                    class="cover relative block w-full aspect-[16/10] overflow-hidden bg-gray-900 cursor-zoom-in focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-white"
                    aria-label={`View media for ${p.name}`}
                  >
                    <img
                      src={cover}
                      alt={p.media?.[0]?.alt ?? `${p.name} screenshot`}
                      loading="lazy"
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    {hasVideo(p) && (
                      <span class="absolute inset-0 flex items-center justify-center">
                        <span class="w-16 h-16 rounded-full bg-black/60 text-white flex items-center justify-center backdrop-blur-sm transition-transform group-hover:scale-110">
                          <Icon name="play" class="w-7 h-7 ml-1 fill-current" />
                        </span>
                      </span>
                    )}
                    {(p.media?.length ?? 0) > 1 && (
                      <span class="absolute right-3 bottom-3 flex items-center gap-1.5 rounded-full bg-gray-900/80 text-white text-xs font-medium px-3 py-1">
                        <Icon name="photo" class="w-4 h-4" />
                        {p.media!.length}
                      </span>
                    )}
                  </button>
                )}

                <div class="p-5 sm:p-8 space-y-4">
                  <div>
                    <span class="text-sm" style="color: var(--accent)">{pad(i)}</span>
                    <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mt-1">
                      {p.name}
                      {p.status && (
                        <span class="ml-2 align-middle text-[0.6rem] sm:text-xs font-semibold uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-300 rounded-full px-2.5 py-0.5">
                          {p.status}
                        </span>
                      )}
                    </h3>
                  </div>
                  <p class="text-base sm:text-lg text-gray-600 leading-relaxed">{p.description}</p>
                  <div class="flex flex-wrap gap-1.5 sm:gap-2">
                    {p.skills.map((s) => (
                      <span class="px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium">
                        {s}
                      </span>
                    ))}
                  </div>
                  {p.links && p.links.length > 0 && (
                    <div class="flex flex-wrap gap-3 pt-2">
                      {p.links.map((l) => (
                        <a
                          href={l.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 text-sm font-semibold px-4 py-2 rounded-lg border border-gray-300 text-gray-900 hover:bg-gray-900 hover:text-white hover:border-gray-900 transition-colors"
                        >
                          {l.kind === 'github' && <Icon name="github" class="w-4 h-4" />}
                          {l.label}
                          <Icon name="arrow" class="w-4 h-4" />
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )
}

<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden flex-col items-center justify-center bg-gray-950/95 px-3 sm:px-16 pt-16 pb-6"
  role="dialog"
  aria-modal="true"
  aria-label="Project media"
>
  <button id="lb-close" type="button" aria-label="Close" class="lb-btn top-3 right-4"><Icon name="x" /></button>
  <button id="lb-prev" type="button" aria-label="Previous" class="lb-btn left-2 sm:left-4 top-1/2 -translate-y-1/2"><Icon name="left" /></button>
  <div id="lb-stage" class="flex-1 min-h-0 w-full flex items-center justify-center"></div>
  <button id="lb-next" type="button" aria-label="Next" class="lb-btn right-2 sm:right-4 top-1/2 -translate-y-1/2"><Icon name="right" /></button>
  <p id="lb-caption" class="mt-4 text-sm text-gray-300 text-center min-h-5"></p>
</div>

<style is:global>
  .filter-btn {
    padding: 0.25rem 0.75rem;
    font-size: 0.8rem;
    border: 1px solid #d1d5db;
    border-radius: 9999px;
    background: #fff;
    color: #4b5563;
    cursor: pointer;
    transition: all 0.2s;
  }
  .filter-btn:hover { border-color: var(--accent); color: var(--accent); }
  .filter-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .lb-btn {
    position: absolute;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    color: #fff;
    background: rgb(255 255 255 / 0.1);
    transition: background 0.2s;
  }
  .lb-btn:hover, .lb-btn:focus-visible { background: rgb(255 255 255 / 0.25); }
  #lightbox.open { display: flex; }
  #lightbox.single #lb-prev, #lightbox.single #lb-next { display: none; }
  #lb-stage img, #lb-stage video { max-width: 100%; max-height: 100%; border-radius: 0.5rem; background: #000; }
</style>

<script>
  interface LbMedia { src: string; type?: 'image' | 'video'; poster?: string; caption?: string; alt?: string }

  const box = document.getElementById('lightbox')!;
  const stage = document.getElementById('lb-stage')!;
  const caption = document.getElementById('lb-caption')!;
  let items: LbMedia[] = [];
  let index = 0;
  let opener: HTMLElement | null = null;

  function render() {
    const item = items[index];
    stage.replaceChildren();
    let el: HTMLImageElement | HTMLVideoElement;
    if (item.type === 'video') {
      const v = document.createElement('video');
      v.src = item.src;
      v.controls = true;
      v.autoplay = true;
      v.playsInline = true;
      if (item.poster) v.poster = item.poster;
      el = v;
    } else {
      const img = document.createElement('img');
      img.src = item.src;
      img.alt = item.alt ?? item.caption ?? '';
      el = img;
    }
    stage.append(el);
    caption.textContent = (item.caption ?? '') + (items.length > 1 ? `  (${index + 1}/${items.length})` : '');
  }

  function open(media: LbMedia[], from: HTMLElement) {
    items = media;
    index = 0;
    opener = from;
    box.classList.add('open');
    box.classList.toggle('single', media.length < 2);
    document.body.style.overflow = 'hidden';
    render();
    document.getElementById('lb-close')!.focus();
  }

  function close() {
    box.classList.remove('open');
    stage.replaceChildren(); // also stops any playing video
    document.body.style.overflow = '';
    opener?.focus();
  }

  const step = (d: number) => {
    index = (index + d + items.length) % items.length;
    render();
  };

  document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
    const cover = card.querySelector<HTMLElement>('.cover');
    cover?.addEventListener('click', () => open(JSON.parse(card.dataset.media ?? '[]'), cover));
  });

  document.getElementById('lb-close')!.addEventListener('click', close);
  document.getElementById('lb-prev')!.addEventListener('click', () => step(-1));
  document.getElementById('lb-next')!.addEventListener('click', () => step(1));
  box.addEventListener('click', (e) => {
    if (e.target === box || e.target === stage) close();
  });
  document.addEventListener('keydown', (e) => {
    if (!box.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft' && items.length > 1) step(-1);
    else if (e.key === 'ArrowRight' && items.length > 1) step(1);
  });

  // Skill filters
  const bar = document.getElementById('project-filters');
  bar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-btn');
    if (!btn) return;
    bar.querySelectorAll('.filter-btn').forEach((b) => b.classList.toggle('active', b === btn));
    const skill = btn.dataset.filter;
    document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
      const skills: string[] = JSON.parse(card.dataset.skills ?? '[]');
      card.hidden = !!skill && !skills.includes(skill);
    });
  });
</script>
