---
import { config } from '../config';
import SectionHeading from './SectionHeading.astro';
---

{
  config.skills.length > 0 && (
    <section id="skills" class="p-8 sm:p-12 md:p-16 lg:p-24 bg-gray-50">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <div class="lg:col-span-4">
          <SectionHeading title="Skills" />
        </div>
        <ul class="lg:col-span-8 flex flex-wrap gap-2 sm:gap-3">
          {config.skills.map((s) => (
            <li class="px-3 sm:px-4 py-1.5 sm:py-2 bg-white border border-gray-200 rounded-lg text-sm sm:text-base font-medium text-gray-800 transition-colors hover:border-[color:var(--accent)] hover:text-[color:var(--accent)]">
              {s}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
