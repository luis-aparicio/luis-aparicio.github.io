---
import { config } from '../config';
import Icon from './Icon.astro';

const socials = [
  { href: `mailto:${config.social.email}`, icon: 'mail', label: 'Email' },
  { href: config.social.linkedin, icon: 'linkedin', label: 'LinkedIn' },
  { href: config.social.github, icon: 'github', label: 'GitHub' },
] as const;

// Decorative floating code symbols: [glyph, top%, left%, delay, rotation]
const glyphs = [
  ['</>', 8, 12, 0, -8], ['=>', 14, 78, 1.2, 6], ['{ }', 62, 70, 2.1, -4],
  ['()', 70, 20, 0.6, 5], ['++', 40, 88, 3, -10], ['//', 30, 6, 1.8, 8],
] as const;
---

<section
  id="top"
  class="relative min-h-[85vh] flex items-center overflow-hidden bg-gradient-to-br from-blue-200/70 via-indigo-50 to-white"
>
  <div class="absolute inset-0 pointer-events-none select-none" aria-hidden="true">
    {
      glyphs.map(([g, top, left, delay, rot]) => (
        <span
          class="absolute text-2xl sm:text-4xl font-bold text-gray-900/10 animate-float"
          style={`top:${top}%;left:${left}%;animation-delay:${delay}s;--r:${rot}deg`}
        >
          {g}
        </span>
      ))
    }
  </div>

  <div class="relative max-w-6xl w-full mx-auto px-8 sm:px-12 py-24">
    <p class="text-lg sm:text-2xl font-semibold text-gray-700 animate-fade-in">Hello! 👋</p>
    <h1
      class="mt-6 sm:mt-8 text-4xl sm:text-5xl md:text-6xl lg:text-8xl font-bold tracking-tight text-gray-800 text-pretty animate-fade-in [animation-delay:200ms]"
    >
      I'm <span style="color: var(--accent)">{config.name}</span>
    </h1>
    <p
      class="mt-6 text-lg sm:text-2xl text-gray-600 font-medium animate-fade-in [animation-delay:400ms]"
    >
      {config.title}
    </p>
    <div class="mt-12 flex gap-5 animate-fade-in [animation-delay:600ms]">
      {
        socials.map((s) => (
          <a
            href={s.href}
            aria-label={s.label}
            target={s.href.startsWith('http') ? '_blank' : undefined}
            rel="noopener noreferrer"
            class="text-gray-700 hover:text-[color:var(--accent)] hover:-translate-y-0.5 transition-all"
          >
            <Icon name={s.icon} class="w-8 h-8" />
          </a>
        ))
      }
    </div>
  </div>
</section>
